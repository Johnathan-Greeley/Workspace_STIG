from typing import Protocol, Any


# ──────────────────────────────────────────────────────────────────────────────
# Core helper objects
# ──────────────────────────────────────────────────────────────────────────────
class Dialog(Protocol):
    def MessageBox(self, message: str, title: str = "", buttons: int = 0) -> int: ...
    def Prompt(self, prompt: str, title: str = "", default: str = "") -> str: ...
    def FileOpenDialog(
        self,
        prompt: str = "",
        default_dir: str = "",
        default_filename: str = "",
        filter_spec: str = "",
    ) -> str: ...


class Screen(Protocol):
    Synchronous: bool
    MatchIndex: int
    CurrentRow: int
    CurrentColumn: int
    Columns: int
    Rows: int

    def Send(self, data: str, suppress_newline: bool = False) -> None: ...
    def SendKeys(self, keys: str) -> None: ...
    def SendSpecial(self, sequence: str) -> None: ...
    def WaitForString(self, *strings: str, timeout: int = 0) -> int: ...
    def WaitForCursor(self, row: int = -1, column: int = -1) -> bool: ...
    def ReadString(self, *end_strings: str, timeout: int = 0) -> str: ...
    def Get(self, row1: int, col1: int, row2: int, col2: int) -> str: ...
    def Get2(self, row1: int, col1: int, row2: int, col2: int) -> str: ...
    def Clear(self) -> None: ...
    def IgnoreEscape(self, ignore: bool = True) -> None: ...


class SessionConfiguration(Protocol):
    def Save(self) -> None: ...
    def SetOption(self, name: str, value: Any) -> None: ...
    def GetOption(self, name: str) -> Any: ...


class Session(Protocol):
    Connected: bool
    Config: SessionConfiguration
    LocalAddress: str
    RemoteAddress: str
    RemotePort: int
    LogUsingSessionOptions: bool
    Logging: bool
    LogFileName: str

    # Connection control
    def Connect(self, connect_string: str) -> None: ...
    def ConnectInTab(self, connect_string: str) -> "Tab": ...
    def Disconnect(self) -> None: ...
    def SetStatusText(self, text: str) -> None: ...

    # Logging helpers
    def Log(self, enable: bool = True) -> None: ...
    def StartLog(self, filename: str) -> None: ...
    def StopLog(self) -> None: ...


class Clipboard(Protocol):
    def Clear(self) -> None: ...
    def GetText(self) -> str: ...
    def SetText(self, text: str) -> None: ...


class FileTransfer(Protocol):
    DownloadFolder: str

    def Download(self, remote_path: str, local_path: str) -> None: ...
    def Upload(self, local_path: str, remote_path: str) -> None: ...
    def AddToZmodemUploadList(self, path: str) -> None: ...


class Window(Protocol):
    Caption: str
    Active: bool

    def Activate(self) -> None: ...
    def Maximize(self) -> None: ...
    def Minimize(self) -> None: ...
    def Restore(self) -> None: ...
    def Close(self) -> None: ...


class Arguments(Protocol):
    Count: int
    def GetArg(self, index: int) -> str: ...


class Tab(Protocol):
    Index: int
    Caption: str
    Screen: Screen
    Session: Session

    def Activate(self) -> None: ...
    def Connect(self, connect_string: str) -> None: ...
    def Disconnect(self) -> None: ...


# ──────────────────────────────────────────────────────────────────────────────
# Application (the top‑level "crt" object)
# ──────────────────────────────────────────────────────────────────────────────
class Application(Protocol):
    # Top‑level properties
    Arguments: Arguments
    Clipboard: Clipboard
    Dialog: Dialog
    FileTransfer: FileTransfer
    Screen: Screen
    Session: Session
    Window: Window
    ActivePrinter: str
    ScriptFullName: str
    Version: str

    # Utility methods
    def Sleep(self, milliseconds: int) -> None: ...
    def Pause(self, message: str = "") -> None: ...
    def WaitForKey(self, milliseconds: int = 0) -> None: ...
    def ClearLastError(self) -> None: ...
    def GetLastError(self) -> int: ...
    def GetLastErrorMessage(self) -> str: ...

    # Tabs
    def GetActiveTab(self) -> Tab: ...
    def GetScriptTab(self) -> Tab: ...
    def GetTab(self, index: int) -> Tab: ...
    def GetTabCount(self) -> int: ...

    # Session‑config helper
    def OpenSessionConfiguration(self, session_path: str = "") -> SessionConfiguration: ...

    # Application lifecycle
    def Quit(self) -> None: ...


# Provided dynamically by SecureCRT at runtime
crt: Application
